SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
DATABASE_URL=sqlite:///starzchat.db
# Regex for valid student IDs (checked after upper-casing)
STUDENT_ID_PATTERN=^[A-Z0-9-]{3,20}$
# Default lifetime of a message, in seconds (86400 = 24 hours)
DEFAULT_MESSAGE_TTL=86400
# How often the cleanup job runs, in seconds
CLEANUP_INTERVAL=60
# --- Rate limiting ---
# Requests per window, per client IP
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_SEND=30/minute
RATE_LIMIT_DEFAULT=120/minute
# Where the counters live. Use Redis in a multi-worker deployment.
RATELIMIT_STORAGE_URI=memory://
# --- Frontend integration ---
# Browser origins allowed to call the API (comma separated, or * for any)
CORS_ORIGINS=*
# Socket.IO client origins (comma separated, or * for any)
SOCKETIO_CORS_ORIGINS=*
# Public base URL of this API, reported by GET /api/docs
API_BASE_URL=http://127.0.0.1:5000
# Set to false to stop serving the bundled demo UI in app/static
SERVE_FRONTEND=true
# Create missing tables on startup (development convenience).
# Set to false in production and run `flask --app run db upgrade` instead.
AUTO_CREATE_SCHEMA=true
